{
  "name": "dslama.net",
  "version": "3.14.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules && npm ci",
    "codegen": "rm -rf src/graphql/generated && graphql-codegen --config codegen.yml",
    "codegen:watch": "npm run codegen -- --watch",
    "predev": "prisma generate",
    "dev": "concurrently -k -p \"{time}-{pid}\" npm:codegen:watch npm:typecheck:watch \"next dev\"",
    "clean:dev": "npm run clean && npm run dev",
    "dev:debug": "concurrently -k -p \"{time}-{pid}\" npm:codegen:watch \"NODE_OPTIONS=--inspect next dev\"",
    "build": "npm run codegen && prisma generate && next build",
    "studio": "npx prisma studio",
    "migrate": "node scripts/assert-local-db.js && prisma migrate reset",
    "start": "node server.js",
    "check:csp": "node scripts/check-csp.js",
    "smoke:server": "node scripts/smoke-server.js",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx src",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:watch": "npm run typecheck -- --watch --preserveWatchOutput",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "image:publish": "docker buildx build --platform linux/amd64 --push -f ../deployment/dslama.net/Dockerfile -t us-central1-docker.pkg.dev/development-262721/dslama-net/full:\"$(git describe)\" .",
    "publish:test": "npm run build && npm version prerelease --preid=g\"$(git rev-parse --short=5 HEAD)\" && npm run image:publish",
    "publish:patch": "npm run build && npm version patch && npm run image:publish",
    "publish:minor": "npm run build && npm version minor && npm run image:publish",
    "publish:major": "npm run build && npm version major && npm run image:publish"
  },
  "dependencies": {
    "@apollo/client": "3.14.1",
    "@apollo/server": "5.5.1",
    "@as-integrations/next": "4.1.0",
    "@graphql-tools/schema": "10.1.5",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-session": "^1.4.0",
    "dotenv": "^8.6.0",
    "final-form": "4.20.10",
    "final-form-arrays": "3.1.0",
    "final-form-focus": "^1.1.2",
    "graphql": "16.14.2",
    "graphql-tag": "^2.10.3",
    "grommet": "2.58.0",
    "grommet-icons": "4.14.0",
    "markdown-to-jsx": "7.4.7",
    "next": "14.2.35",
    "next-connect": "^0.10.2",
    "pino": "6.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-final-form": "6.5.9",
    "react-final-form-arrays": "3.1.4",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "2.16.5",
    "@graphql-codegen/typescript": "2.8.8",
    "@graphql-codegen/typescript-operations": "2.5.13",
    "@graphql-codegen/typescript-react-apollo": "3.3.7",
    "@graphql-codegen/typescript-resolvers": "2.7.13",
    "@testing-library/react": "14.3.1",
    "@types/babel__traverse": "7.18.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-session": "^2.0.43",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "concurrently": "^6.2.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.9.10",
    "prisma": "5.22.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
